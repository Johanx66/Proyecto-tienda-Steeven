# Variables para Docker Compose (opcional).
# Copia este archivo a `.env` en la raíz y rellena las credenciales de Twilio
# para habilitar el Voice 2FA real. Si se dejan vacías, el sistema funciona
# igual salvo la llamada telefónica.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# URL pública de Ngrok (ej: https://xxxx.ngrok-free.app) para los webhooks de Twilio
WEBHOOK_BASE_URL=
