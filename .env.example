# Variables para Docker Compose (opcional).
# Copia este archivo a `.env` en la raíz y ajusta los valores.
# Docker Compose usa este archivo para sustituir las variables `${...}` del
# `docker-compose.yml` (no se inyecta automáticamente dentro de los contenedores).

# ===== Base de datos =====
DB_NAME=tienda_frescos
DB_USER=postgres
DB_PASSWORD=postgres

# ===== Autenticación =====
# Cadena larga y aleatoria. Cámbiala antes de desplegar en producción.
JWT_SECRET=cambia_esta_clave_secreta_en_produccion_1234567890
JWT_EXPIRES_IN=7d

# ===== Servidor =====
FRONTEND_URL=http://localhost
# Puerto local para el frontend en Docker Compose. En EC2 con Caddy,
# configura FRONTEND_PORT=127.0.0.1:8080 para que Caddy sea el único acceso web.
FRONTEND_PORT=80
# URL pública usada para construir los enlaces del correo
WEBHOOK_BASE_URL=http://localhost

# ===== Correo electrónico =====
# Con MAIL_MOCK=true se imprimen los enlaces de confirmación en la consola
# del backend en vez de enviarlos.
MAIL_MOCK=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Cuenta que autentica en Gmail.
SMTP_USER=
# Contraseña de APLICACIÓN de Gmail (16 caracteres, sin espacios), no la
# contraseña normal de la cuenta:
# Google Cuenta > Seguridad > Verificación en dos pasos > Contraseñas de aplicaciones.
SMTP_PASS=
# El remitente debe coincidir con SMTP_USER o Gmail rechaza el envío (553).
MAIL_FROM="Frutería Web <no-reply@fruteria.local>"
VERIFICATION_TOKEN_TTL_MINUTES=30
