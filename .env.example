# Variables para Docker Compose (opcional).
# Copia este archivo a `.env` en la raíz y rellena las credenciales SMTP
# para habilitar el envío real de correos. Con MAIL_MOCK=true se imprimen
# los enlaces de confirmación en la consola del backend en vez de enviarlos.
MAIL_MOCK=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Frutería Web <no-reply@fruteria.local>
VERIFICATION_TOKEN_TTL_MINUTES=30
# URL pública usada para construir los enlaces del correo
WEBHOOK_BASE_URL=http://localhost:5000
