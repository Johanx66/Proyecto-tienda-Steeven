PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tienda_frescos
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=your_super_secret_key_min_32_chars_long_ok
JWT_EXPIRES_IN=7d

# Cuenta administradora: define una clave propia (mínimo 16 caracteres)
ADMIN_EMAIL=admin@tiendafrescos.local
ADMIN_PASSWORD=
ADMIN_NAME=Administrador de la tienda
ADMIN_PHONE=+570000000000

MAIL_MOCK=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
MAIL_FROM=Frutería Web <tu_correo@gmail.com>
VERIFICATION_TOKEN_TTL_MINUTES=30

FRONTEND_URL=http://localhost:5173
WEBHOOK_BASE_URL=http://localhost:5000

# Avisos opcionales por Telegram (username sin @)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Notificaciones push web (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
